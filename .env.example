# QQ Bot credentials
QQ_BOT_APP_ID=your_app_id
QQ_BOT_APP_SECRET=your_app_secret

# Gateway intents (comma-separated)
# GROUP_AT_MESSAGE_CREATE - group @bot messages
# GROUP_MESSAGE_CREATE - all group messages (private bot only)
# C2C_MESSAGE_CREATE - direct messages
INTENTS=GROUP_AT_MESSAGE_CREATE

# HTTP server (plugin APIs)
HTTP_PORT=3000

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=modernwar
